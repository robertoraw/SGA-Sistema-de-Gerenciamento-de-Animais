#while true faz o while entrar em loop infinito
    while True:
#try: tente executar esse input (que pede um float)
        try:
            peso = float(input("Peso: "))
#se o valor inserido for numero ele passará pelo if
            if peso <= 0 or peso >= 1000:
                print("O peso não pode ser menor que 0 nem maior que 1000!")
            else:
                break
#se o valor inserido lá encima não for numero ele ira para o except
        except:
            print("Digite somente números!")
